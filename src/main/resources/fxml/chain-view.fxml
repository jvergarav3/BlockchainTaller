<?xml version="1.0" encoding="UTF-8"?>

<?import blockchain.core.chain.presentation.javafx.components.Icon?>
<?import blockchain.core.chain.presentation.javafx.components.ToastHost?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="blockchain.core.chain.presentation.javafx.controllers.ChainController"
           styleClass="app-root">
    <fx:define>
        <ToggleGroup fx:id="criteriaGroup"/>
    </fx:define>

    <BorderPane>
        <top>
            <VBox styleClass="app-top">
                <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="logo">
                        <Icon name="link" styleClass="logo-icon"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Blockchain" styleClass="brand-title"/>
                        <Label text="Lista enlazada simple · bloques inmutables" styleClass="brand-sub"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="validateButton" text="Validar cadena" styleClass="btn, btn-secondary"
                            onAction="#onValidate">
                        <graphic><Icon name="shield"/></graphic>
                    </Button>
                </HBox>
                <HBox styleClass="command-bar" alignment="CENTER_LEFT" spacing="10">
                    <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <TextField fx:id="dataField" styleClass="input, input-icon-left"
                                   promptText="Datos de la transacción, p. ej. Alice paga 10 a Bob   (Ctrl+N)"
                                   onAction="#onAddBlock"/>
                        <Icon name="link" styleClass="input-icon"/>
                    </StackPane>
                    <Button fx:id="addButton" text="Agregar bloque" styleClass="btn, btn-primary"
                            onAction="#onAddBlock">
                        <graphic><Icon name="plus"/></graphic>
                    </Button>
                    <Region styleClass="divider-v"/>
                    <HBox styleClass="segmented" alignment="CENTER_LEFT" spacing="2">
                        <ToggleButton fx:id="criteriaText" text="Texto" styleClass="segment" selected="true"
                                      toggleGroup="$criteriaGroup"/>
                        <ToggleButton fx:id="criteriaId" text="ID" styleClass="segment"
                                      toggleGroup="$criteriaGroup"/>
                        <ToggleButton fx:id="criteriaHash" text="Hash" styleClass="segment"
                                      toggleGroup="$criteriaGroup"/>
                    </HBox>
                    <StackPane prefWidth="250" minWidth="200" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" styleClass="input, input-icon-left, input-icon-right"
                                   promptText="Buscar…   (Ctrl+F)" onAction="#onSearch"/>
                        <Icon name="search" styleClass="input-icon"/>
                        <Button fx:id="searchClearButton" styleClass="icon-btn, input-clear"
                                StackPane.alignment="CENTER_RIGHT" onAction="#onClearSearch">
                            <graphic><Icon name="close"/></graphic>
                        </Button>
                    </StackPane>
                    <Label fx:id="searchInfo" styleClass="search-info" minWidth="86"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox styleClass="workspace" spacing="14">
                <HBox styleClass="stats" spacing="12">
                    <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <Region styleClass="dot, dot-total"/>
                            <Label text="BLOQUES" styleClass="stat-label"/>
                        </HBox>
                        <Label fx:id="totalValue" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <Region styleClass="dot, dot-normal"/>
                            <Label text="NORMALES" styleClass="stat-label"/>
                        </HBox>
                        <Label fx:id="normalValue" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <Region styleClass="dot, dot-correction"/>
                            <Label text="CORRECCIONES" styleClass="stat-label"/>
                        </HBox>
                        <Label fx:id="correctionValue" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <Region styleClass="dot, dot-annulment"/>
                            <Label text="ANULACIONES" styleClass="stat-label"/>
                        </HBox>
                        <Label fx:id="annulmentValue" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-tile, stat-wide" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <Region fx:id="integrityDot" styleClass="dot, dot-idle"/>
                            <Label text="INTEGRIDAD" styleClass="stat-label"/>
                        </HBox>
                        <HBox alignment="BASELINE_LEFT" spacing="10">
                            <Label fx:id="integrityValue" text="Vacía" styleClass="stat-value"/>
                            <Label fx:id="integritySub" text="" styleClass="stat-sub"/>
                        </HBox>
                    </VBox>
                </HBox>

                <VBox fx:id="canvasCard" styleClass="canvas-card" VBox.vgrow="ALWAYS">
                    <HBox styleClass="canvas-header" alignment="CENTER_LEFT" spacing="10">
                        <Label text="Cadena de bloques" styleClass="canvas-title"/>
                        <Label fx:id="sizeLabel" text="size = 0" styleClass="pill, size-pill"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Region styleClass="dot, dot-normal"/>
                            <Label text="Normal" styleClass="legend-label"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Region styleClass="dot, dot-correction"/>
                            <Label text="Corrección" styleClass="legend-label"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Region styleClass="dot, dot-annulment"/>
                            <Label text="Anulación" styleClass="legend-label"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Region styleClass="dot, dot-fresh"/>
                            <Label text="Nuevo" styleClass="legend-label"/>
                        </HBox>
                    </HBox>
                    <ScrollPane fx:id="chainScroll" styleClass="chain-scroll" fitToWidth="true"
                                vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <StackPane fx:id="chainHolder" styleClass="chain-holder" alignment="CENTER"/>
                    </ScrollPane>
                    <HBox styleClass="canvas-footer" alignment="CENTER_LEFT">
                        <Label text="←  → navegar   ·   Esc cerrar   ·   Ctrl+F buscar   ·   Ctrl+N nuevo   ·   Ctrl+L validar"
                               styleClass="hint"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>

        <right>
            <StackPane fx:id="detailsHolder" styleClass="details-holder"/>
        </right>
    </BorderPane>

    <ToastHost fx:id="toastHost" StackPane.alignment="BOTTOM_CENTER"/>
</StackPane>
